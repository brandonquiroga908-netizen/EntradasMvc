@model EntradasMvc.ViewModels.ResultadoCotizacionViewModel

@{
    ViewData["Title"] = "Resultado de la cotización";
}

<h1>Resultado de la cotización</h1>

<div class="card">
    <div class="card-body">

        <h4>@Model.Evento</h4>

        <p>
            <strong>Fecha del evento:</strong>
            @Model.FechaEvento.ToString("dd/MM/yyyy")
        </p>

        <hr />

        <p>
            <strong>Cliente:</strong>
            @Model.Cotizacion.Cliente
        </p>

        <p>
            <strong>Tipo de entrada:</strong>
            @Model.TipoEntrada
        </p>

        <p>
            <strong>Cantidad de entradas:</strong>
            @Model.Cotizacion.Cantidad
        </p>

        <p>
            <strong>Precio unitario:</strong>
            Bs @Model.Cotizacion.PrecioUnitario.ToString("0.00")
        </p>

        <p>
            <strong>Subtotal:</strong>
            Bs @Model.Cotizacion.Subtotal.ToString("0.00")
        </p>

        <p>
            <strong>Descuento:</strong>
            Bs @Model.Cotizacion.Descuento.ToString("0.00")
        </p>

        <p>
            <strong>Total:</strong>
            Bs @Model.Cotizacion.Total.ToString("0.00")
        </p>

        <hr />

        <div class="alert alert-success">
            @Model.Mensaje
        </div>

        <a asp-controller="Entradas"
           asp-action="Index"
           class="btn btn-primary">
            Nueva cotización
        </a>

    </div>
</div>